      "panel-8": {
        "kind": "Panel",
        "spec": {
          "id": 8,
          "title": "VPD",
          "description": "Vapor Pressure Deficit calculated from temperature_f and humidity_percent.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "influxdb",
                      "version": "v0",
                      "datasource": {
                        "name": "${datasource}"
                      },
                      "spec": {
                        "query": "import \"math\"\n\nfrom(bucket: \"pi_sensors\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"plant_environment\")\n  |> filter(fn: (r) => r.location == \"plant_shelf\")\n  |> filter(fn: (r) => r._field == \"temperature_f\" or r._field == \"humidity_percent\")\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)\n  |> pivot(rowKey: [\"_time\"], columnKey: [\"_field\"], valueColumn: \"_value\")\n  |> filter(fn: (r) => exists r.temperature_f and exists r.humidity_percent)\n  |> map(fn: (r) => ({\n    r with\n    _field: \"vpd_kpa\",\n    _value: (\n      0.6108 *\n      math.exp(x: (17.27 * ((r.temperature_f - 32.0) * 5.0 / 9.0)) / (((r.temperature_f - 32.0) * 5.0 / 9.0) + 237.3))\n    ) * (1.0 - (r.humidity_percent / 100.0))\n  }))\n  |> keep(columns: [\"_time\", \"_field\", \"_value\"])\n  |> yield(name: \"vpd\")"
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "timeseries",
            "version": "13.0.1",
            "spec": {
              "options": {
                "annotations": {
