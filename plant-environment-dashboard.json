                    "lastNotNull",
                    "mean",
                    "min",
                    "max"
                  ],
                  "displayMode": "list",
                  "placement": "bottom",
                  "showLegend": true
                },
                "tooltip": {
                  "hideZeros": false,
                  "mode": "multi",
                  "sort": "none"
                }
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "pressurekpa",
                  "decimals": 2,
                  "min": 0,
                  "thresholds": {
                    "mode": "absolute",
                    "steps": [
                      {
                        "value": 0,
                        "color": "orange"
                      },
                      {
                        "value": 0.4,
                        "color": "green"
                      },
                      {
                        "value": 0.9,
                        "color": "orange"
                      },
                      {
                        "value": 1.3,
